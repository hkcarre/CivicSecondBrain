# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# App
NEXT_PUBLIC_APP_NAME="CivicSecondBrain — Schertz, TX"
NEXT_PUBLIC_CITY_NAME="Schertz"
NEXT_PUBLIC_CITY_STATE="TX"
# Server-side city identity (used in AI prompts; defaults to NEXT_PUBLIC_* above)
CITY_NAME="Schertz"
CITY_STATE="TX"

# AWS (for production deployment)
AWS_REGION=us-east-1
AWS_S3_BUCKET_RAW=civic-secondbrain-raw-sources
AWS_S3_BUCKET_WIKI=civic-secondbrain-wiki

# Auth (AWS Cognito — for production)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=

# Wiki paths (local dev)
WIKI_PATH=./wiki
RAW_SOURCES_PATH=./raw-sources

# Admin panel auth
# Set a strong password to restrict access to /admin. When unset, /admin is open (dev mode only).
# Generate one: openssl rand -base64 24
ADMIN_PASSWORD=

# API route auth — shared secret for /api/ingest and /api/lint
# Set a long random string (e.g. openssl rand -hex 32) to restrict access to these endpoints.
# Callers must send:  Authorization: Bearer <your-secret>
# If unset, requests are accepted without auth (dev / local mode only — always set in production).
INGEST_SECRET=

# Ingest limits — tune to available memory
# MAX_FILE_SIZE_MB: skip PDFs larger than this (default 25; raise to 50-100 with more RAM)
MAX_FILE_SIZE_MB=25

# Schertz data source
SCHERTZ_GOV_URL=https://www.schertz.com/27/Government
SCHERTZ_LASERFICHE_URL=https://www.schertz.com/AgendaCenter
SCHERTZ_MUNICODE_URL=https://library.municode.com/tx/schertz
