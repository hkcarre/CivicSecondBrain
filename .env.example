# ── AI Provider config ─────────────────────────────────────────────────────
# AI_PROVIDER: which AI backend to use — "anthropic" (default), "openai", or "gemini"
# AI_MODEL: override the model name (optional; each provider has a sensible default)
AI_PROVIDER=anthropic
AI_MODEL=

# Anthropic (default provider)
ANTHROPIC_API_KEY=***

# OpenAI (set AI_PROVIDER=openai to use)
OPENAI_API_KEY=
# OPENAI_BASE_URL: optional base URL override (e.g. for proxies or Azure OpenAI)
OPENAI_BASE_URL=

# Google Gemini (set AI_PROVIDER=gemini to use)
# Uses OpenAI-compatible endpoint at generativelanguage.googleapis.com/v1beta/openai/
# Default model: gemini-2.0-flash
GEMINI_API_KEY=

# App
NEXT_PUBLIC_APP_NAME="CivicSecondBrain — Schertz, TX"
# City identity — set ONLY this NEXT_PUBLIC_ pair. It drives the browser UI
# (Next.js inlines NEXT_PUBLIC_ vars into the client bundle at build time) AND
# the server-side AI prompts (read at runtime; they fall back to these values).
NEXT_PUBLIC_CITY_NAME="Schertz"
NEXT_PUBLIC_CITY_STATE="TX"
# Optional server-side overrides — only needed if the AI prompts should use a
# different city string than the UI (rare). When set, they win server-side; a
# warning is logged if they diverge from the NEXT_PUBLIC_ pair.
# CITY_NAME="Schertz"
# CITY_STATE="TX"

# ── Multi-city scraper config ──────────────────────────────────────────────
# CIVICPLUS_URL: full CivicPlus "Government" section URL for your city.
# The scraper derives the site root from it to reach DocumentCenter, Finance,
# and Public Notices pages.
# (Deprecated alias: SCHERTZ_GOV_URL — still works, logs a warning.)
CIVICPLUS_URL=https://www.schertz.com/27/Government

# LASERFICHE_URL: base URL of the city's Laserfiche WebLink instance — the
# host that serves /WebLink/Browse.aspx. Defaults to the Schertz instance.
# (Deprecated alias: SCHERTZ_LASERFICHE_URL — still works, logs a warning.)
LASERFICHE_URL=https://laserfiche.schertzweb.com

# GOV_BASE_URL: optional explicit root URL of the city government website
# (no trailing slash). Takes precedence over the CIVICPLUS_URL-derived root.
# Example for another CivicPlus city: https://www.newbraunfels.gov
GOV_BASE_URL=

# AWS (for production deployment)
AWS_REGION=us-east-1
AWS_S3_BUCKET_RAW=civic-secondbrain-raw-sources
AWS_S3_BUCKET_WIKI=civic-secondbrain-wiki

# Auth (AWS Cognito — for production)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=

# Wiki paths (local dev)
WIKI_PATH=./wiki
RAW_SOURCES_PATH=./raw-sources

# Admin panel auth
# Set a strong password to restrict access to /admin. When unset, /admin is open (dev mode only).
# Generate one: openssl rand -base64 24
ADMIN_PASSWORD=

# API route auth — shared secret for /api/ingest and /api/lint
# Set a long random string (e.g. openssl rand -hex 32) to restrict access to these endpoints.
# Callers must send:  Authorization: Bearer <your-secret>
# If unset, requests are accepted without auth (dev / local mode only — always set in production).
INGEST_SECRET=

# Chat rate limit — max /api/chat requests per minute per client IP
# Protects against runaway AI API costs from crawl bursts or abuse.
# In-memory sliding window (single-replica deployment). Default: 20
CHAT_RATE_LIMIT_RPM=20

# Ingest limits — tune to available memory
# MAX_FILE_SIZE_MB: skip PDFs larger than this (default 25; raise to 50-100 with more RAM)
MAX_FILE_SIZE_MB=25

# MuniCode ordinance scraper — set to your city's MuniCode URL to enable
# Leave blank to skip MuniCode scraping (safe — other sources still ingest)
# (Deprecated alias: SCHERTZ_MUNICODE_URL — still works)
MUNICODE_URL=https://library.municode.com/tx/schertz/codes/code_of_ordinances
