{
  "name": "civic-second-brain",
  "version": "1.31.8",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "ingest:seed": "node --max-old-space-size=768 --expose-gc -r ./scripts/load-env.cjs -r tsx/cjs scripts/ingest-seed.ts",
    "ingest:doc": "node --max-old-space-size=768 --expose-gc -r ./scripts/load-env.cjs -r tsx/cjs scripts/ingest-doc.ts",
    "ingest:facts": "node --max-old-space-size=768 --expose-gc -r ./scripts/load-env.cjs -r tsx/cjs scripts/ingest-facts.ts",
    "lint:wiki": "node --max-old-space-size=512 -r ./scripts/load-env.cjs -r tsx/cjs scripts/lint-wiki.ts",
    "scrape:check": "node --max-old-space-size=256 -r ./scripts/load-env.cjs -r tsx/cjs scripts/scraper-check.ts",
    "eval:chat": "node -r ./scripts/load-env.cjs -r ./scripts/load-eval-fixture.cjs -r tsx/cjs scripts/eval-chat.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "ai": "^7.0.31",
    "axios": "^1.7.2",
    "cheerio": "^1.0.0-rc.12",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.25.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.6",
    "nanoid": "^6.0.0",
    "next": "16.2.10",
    "openai": "^6.48.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^2.15.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.15.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.7",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
